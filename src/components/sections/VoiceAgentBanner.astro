---
import type { Lang } from '../../i18n';
import OrganicBlob from '../decorations/OrganicBlob.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const TALK_URL = 'https://ai-caller.gonor.me/talk';

const labels = {
  es: {
    eyebrow: 'Nuevo · agente de voz',
    title: 'Pregúntale a mi asistente de IA',
    body: 'Habla en voz alta con un asistente que conoce mi experiencia, mis certificaciones y mis proyectos. Pregúntale qué hago en Levely, qué certificaciones tengo o qué proyecto ver primero.',
    note: 'Español o inglés · hasta 4 minutos · usa tu micrófono',
    cta: 'Hablar con el asistente',
    how: 'Cómo lo construí',
    howHref: '/blog/voice-agent/',
  },
  en: {
    eyebrow: 'New · voice agent',
    title: 'Ask my AI assistant',
    body: 'Talk out loud with an assistant that knows my work experience, certifications and projects. Ask it what I do at Levely, which certifications I hold, or which project to look at first.',
    note: 'Spanish or English · up to 4 minutes · uses your microphone',
    cta: 'Talk to the assistant',
    how: 'How I built it',
    howHref: '/en/blog/voice-agent/',
  },
}[lang];
---

<section class="relative px-4 sm:px-6 pb-10" aria-labelledby="voice-agent-title">
  <div class="max-w-6xl mx-auto">
    <div class="relative overflow-hidden rounded-xl bg-navy text-cream px-5 py-7 sm:px-8 md:px-10 md:py-8 fade-up">
      <OrganicBlob variant={2} color="#D4A574" class="w-[320px] h-[320px] -top-28 -right-20 opacity-20" />
      <OrganicBlob variant={4} color="#C17654" class="w-[220px] h-[220px] -bottom-24 left-1/3 opacity-15" />

      <div class="relative z-10 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-center">
        <div class="hidden md:flex md:col-span-2 justify-center">
          <a
            href={TALK_URL}
            target="_blank"
            rel="noopener"
            tabindex="-1"
            aria-hidden="true"
            data-voice-agent-cta
            class="relative w-24 h-24 rounded-full bg-terracotta flex items-center justify-center voice-pulse hover:bg-terracotta/90 hover:scale-105 transition-transform"
          >
            <svg viewBox="0 0 24 24" class="w-10 h-10" fill="none" stroke="#FFF8F0" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="3" width="6" height="11" rx="3" />
              <path d="M5 11a7 7 0 0 0 14 0" />
              <path d="M12 18v3" />
            </svg>
          </a>
        </div>

        <div class="md:col-span-6">
          <p class="text-amber text-xs font-bold uppercase tracking-widest mb-2">{labels.eyebrow}</p>
          <h2 id="voice-agent-title" class="font-serif text-2xl md:text-3xl font-bold text-cream mb-3">
            {labels.title}
          </h2>
          <p class="text-cream/80 text-base leading-relaxed max-w-xl !text-left [hyphens:manual]">{labels.body}</p>
          <p class="text-cream/60 text-sm mt-3 !text-left">{labels.note}</p>
        </div>

        <div class="md:col-span-4 flex flex-col sm:flex-row md:flex-col gap-3 md:items-end">
          <a
            href={TALK_URL}
            target="_blank"
            rel="noopener"
            data-voice-agent-cta
            class="inline-flex items-center justify-center gap-2 min-h-[44px] px-6 py-3 bg-terracotta text-cream font-medium rounded-xl hover:bg-terracotta/90 transition-colors"
          >
            <svg viewBox="0 0 24 24" class="w-5 h-5 md:hidden" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="3" width="6" height="11" rx="3" />
              <path d="M5 11a7 7 0 0 0 14 0" />
              <path d="M12 18v3" />
            </svg>
            {labels.cta}
          </a>
          <a
            href={labels.howHref}
            class="inline-flex items-center justify-center min-h-[44px] px-4 text-cream/80 underline underline-offset-4 hover:text-amber transition-colors"
          >
            {labels.how}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .voice-pulse::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 9999px;
    border: 2px solid rgba(193, 118, 84, 0.45);
    animation: voice-ring 2.4s ease-out infinite;
  }
  @keyframes voice-ring {
    from { transform: scale(0.85); opacity: 1; }
    to { transform: scale(1.25); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .voice-pulse::after { animation: none; opacity: 0.5; }
  }
</style>
