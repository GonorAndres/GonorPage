---
import { t } from '../../i18n';
import type { Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const targetLang = lang === 'es' ? 'en' : 'es';

// Build the target URL by toggling the /en/ prefix.
// The 404 page is built as /404/, so a prefix would point at /en/404/, which does not exist.
const currentPath = Astro.url.pathname;
const isNotFoundPage = currentPath === '/404' || currentPath === '/404/' || currentPath === '/404.html';
let targetPath: string;
if (isNotFoundPage) {
  targetPath = lang === 'es' ? '/en/' : '/';
} else if (lang === 'es') {
  targetPath = `/en${currentPath}`;
} else {
  targetPath = currentPath.replace(/^\/en/, '') || '/';
}
---

<a
  href={targetPath}
  class="inline-flex items-center min-h-[44px] text-sm font-medium px-3 py-1.5 rounded border border-amber/40 text-navy/70 hover:bg-amber/10 hover:text-terracotta transition-colors"
>
  {t(lang, 'lang.switch')}
</a>
