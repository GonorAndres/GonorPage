---
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n';
import { categoryLabels, type Category } from '../data/categories';
import 'katex/dist/katex.min.css';

export type PostShape = 'blog' | 'case-study' | 'narrative' | 'study-guide';

export interface FichaFields {
  rol?: string;
  año?: string;
  periodo?: string;
  stack?: string;
  datos?: string;
  regulacion?: string;
  estado?: string;
  repositorio?: string;
  live?: string;
  extraLinks?: { label: string; url: string }[];
}

export interface RelatedPost {
  slug: string;
  title: string;
  date: string;
  category: Category;
}

interface Props {
  title: string;
  description: string;
  date: string;
  lastModified?: string;
  category: string;
  tags?: string[];
  lang: Lang;
  shape?: PostShape;
  readingTime: string;
  ficha?: FichaFields;
  heroImage?: string;
  heroCaption?: string;
  heroAlt?: string;
  relatedPosts: RelatedPost[];
}

const {
  title,
  description,
  date,
  lastModified,
  category,
  tags = [],
  lang,
  shape = 'blog',
  readingTime,
  ficha,
  heroImage,
  heroCaption,
  heroAlt,
  relatedPosts,
} = Astro.props;

const dateFmt = new Intl.DateTimeFormat(lang === 'es' ? 'es-MX' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const formattedDate = dateFmt.format(new Date(`${date}T12:00:00`));
const formattedUpdated = lastModified
  ? dateFmt.format(new Date(`${lastModified}T12:00:00`))
  : undefined;

const categoryDisplay = categoryLabels[lang]?.[category as Category] ?? category;
const categoryHref =
  lang === 'es' ? `/blog/categoria/${category}/` : `/en/blog/categoria/${category}/`;
const backHref = lang === 'es' ? '/blog/' : '/en/blog/';
const heroThumbnail = heroImage?.startsWith('/blog-illustrations/')
  ? heroImage.replace('/blog-illustrations/', '/blog-illustrations/thumbs/')
  : undefined;

const CATEGORY_COLOR: Record<Category, string> = {
  'actuaria-para-todos': '#7A8B6F',
  'fundamentos-actuariales': '#C17654',
  'proyectos-y-analisis': '#5B7B9A',
  'herramientas': '#D4A574',
  'mercado-mexicano': '#1B2A4A',
};
const catColor = CATEGORY_COLOR[category as Category] ?? '#1B2A4A';

const L = {
  by: lang === 'es' ? 'Por' : 'By',
  updated: lang === 'es' ? 'actualizado' : 'updated',
  read: lang === 'es' ? 'de lectura' : 'read',
  ficha: lang === 'es' ? 'Ficha' : 'About',
  rol: lang === 'es' ? 'Rol' : 'Role',
  año: lang === 'es' ? 'Año' : 'Year',
  periodo: lang === 'es' ? 'Periodo' : 'Period',
  stack: 'Stack',
  datos: lang === 'es' ? 'Datos' : 'Data',
  regulacion: lang === 'es' ? 'Regulación' : 'Regulation',
  estado: lang === 'es' ? 'Estado' : 'Status',
  repo: lang === 'es' ? 'Repositorio' : 'Repository',
  live: 'Live',
  links: 'Links',
  topics: 'Tags',
  date: lang === 'es' ? 'Fecha' : 'Date',
  lastMod: lang === 'es' ? 'Última edición' : 'Last edit',
  readTime: lang === 'es' ? 'Tiempo' : 'Reading',
  series: lang === 'es' ? 'Serie' : 'Series',
  related: lang === 'es' ? 'Relacionados' : 'Related',
  backToBlog: lang === 'es' ? 'Volver al blog' : 'Back to blog',
};

const fichaRows: { key: string; value: string; href?: string }[] = [];
if (shape === 'case-study' && ficha) {
  if (ficha.rol) fichaRows.push({ key: L.rol, value: ficha.rol });
  if (ficha.año) fichaRows.push({ key: L.año, value: ficha.año });
  if (ficha.periodo) fichaRows.push({ key: L.periodo, value: ficha.periodo });
  if (ficha.stack) fichaRows.push({ key: L.stack, value: ficha.stack });
  if (ficha.datos) fichaRows.push({ key: L.datos, value: ficha.datos });
  if (ficha.regulacion) fichaRows.push({ key: L.regulacion, value: ficha.regulacion });
  if (ficha.estado) fichaRows.push({ key: L.estado, value: ficha.estado });
  if (ficha.repositorio) fichaRows.push({ key: L.repo, value: 'GitHub', href: ficha.repositorio });
  if (ficha.live) fichaRows.push({ key: L.live, value: 'Demo', href: ficha.live });
  (ficha.extraLinks ?? []).forEach((l) =>
    fichaRows.push({ key: L.links, value: l.label, href: l.url })
  );
}

const prose = shape;
const metaDescription = description.length <= 160
  ? description
  : `${description.slice(0, 157).replace(/\s+\S*$/, '')}…`;
---

<BaseLayout
  title={`${title} | AGO Blog`}
  description={metaDescription}
  structuredDescription={description}
  contentTitle={title}
  articleSchema="BlogPosting"
  lang={lang}
  ogType="article"
  datePublished={date}
  dateModified={lastModified}
  image={heroImage}
  imageAlt={heroAlt ?? title}
  section={categoryDisplay}
  tags={tags}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: lang === 'es' ? 'Inicio' : 'Home',
            item: lang === 'es' ? 'https://gonor.me/' : 'https://gonor.me/en/',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: 'Blog',
            item: `https://gonor.me${backHref}`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: title,
          },
        ],
      })}
    />
  </Fragment>
  <article class="py-6 md:py-10 px-4 sm:px-6">
    <div class="max-w-[1020px] mx-auto">
      <nav
        class="pd-back font-mono text-[11px] uppercase tracking-[0.12em] text-[#1B2A4A]/70 mb-4"
        aria-label={lang === 'es' ? 'Ruta de navegación' : 'Breadcrumb'}
      >
        <a href={backHref} class="inline-flex items-center min-h-[44px] hover:text-[#A35E3E] no-underline">← {L.backToBlog}</a>
      </nav>

      <header class="post-heading">
        <div class="pd-kicker mb-3">
          <a
            href={categoryHref}
            class="inline-flex items-center gap-2 min-h-[44px] font-mono text-[10px] uppercase tracking-[0.14em] text-[#1B2A4A]/75 no-underline hover:text-[#1B2A4A] transition-colors"
          >
            <span class="h-1.5 w-1.5 rounded-full" style={`background-color: ${catColor};`} aria-hidden="true"></span>
            {categoryDisplay}
          </a>
        </div>

        <h1
          class="font-serif font-semibold text-[32px] md:text-[44px] lg:text-[48px] text-[#1B2A4A] leading-[1.12] tracking-tight mb-5 text-balance break-words"
        >
          {title}
        </h1>

        <div class="byline text-xs leading-relaxed text-[#1B2A4A]/75 flex flex-wrap items-center gap-x-4 gap-y-1 pb-5">
          <span>
            {L.by}{' '}
            <a
              href={lang === 'es' ? '/about/' : '/en/about/'}
              rel="author"
              class="inline-flex items-center min-h-[44px] text-[#1B2A4A] font-medium hover:text-[#A35E3E] underline underline-offset-4"
            >
              Andrés González Ortega
            </a>
          </span>
          <time datetime={date}>{formattedDate}</time>
          <span>{readingTime} {L.read}</span>
          {formattedUpdated && <span>{L.updated} <time datetime={lastModified}>{formattedUpdated}</time></span>}
        </div>
      </header>

      {heroImage && (
        <figure class="hero-img mb-8">
          <picture class="block overflow-hidden rounded-lg border border-[#1B2A4A]/15 bg-[#E8E0D7]">
            {heroThumbnail && (
              <source
                type="image/webp"
                srcset={`${heroThumbnail} 640w, ${heroImage} 1536w`}
                sizes="(min-width: 1068px) 1020px, (min-width: 640px) calc(100vw - 48px), calc(100vw - 32px)"
              />
            )}
            <img
              src={heroImage}
              alt={heroAlt ?? ''}
              width="1536"
              height="864"
              class="block w-full aspect-[16/9] object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          {heroCaption && (
            <figcaption class="text-xs sm:text-sm leading-relaxed text-[#1B2A4A]/75 mt-3 max-w-[85ch]">
              {heroCaption}
            </figcaption>
          )}
        </figure>
      )}

      <section class="lede max-w-[68ch] mb-8 p-5 md:p-6 border border-[#C17654]/45 rounded-md bg-[#C17654]/5" aria-label={lang === 'es' ? 'Resumen' : 'Summary'}>
        <p class="font-serif text-lg md:text-[19px] leading-[1.6] text-[#1B2A4A]/85 text-left">
          {description}
        </p>
      </section>

      <div class="pd-body grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_220px] gap-x-12 gap-y-10 mt-10 items-start">
        <div
          class:list={[
            'prose min-w-0 max-w-none',
            'text-[#1B2A4A]',
            'prose-p:leading-[1.65] prose-p:text-[#1B2A4A]/85',
            'prose-a:text-[#A35E3E] prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-[#1B2A4A]',
            'prose-strong:text-[#1B2A4A] prose-strong:font-semibold',
            'prose-code:font-mono prose-code:text-[#A35E3E] prose-code:bg-[#E8E0D7] prose-code:px-1 prose-code:rounded prose-code:before:content-none prose-code:after:content-none',
            'prose-blockquote:border-l-[#C17654] prose-blockquote:bg-[#C17654]/5 prose-blockquote:italic prose-blockquote:text-[#1B2A4A]',
            'prose-li:text-[#1B2A4A]/85',
            'prose-img:rounded',
          ]}
          data-shape={prose}
        >
          <slot />
        </div>

        <aside class="pd-side self-start md:self-stretch">
          <div
            class="lbl font-mono text-[10px] uppercase tracking-[0.18em] text-[#1B2A4A]/70 pb-2.5 border-b border-[#1B2A4A]/15 mb-3"
          >
            {L.ficha}
          </div>

          <div class="row hidden md:flex items-baseline gap-3 py-1.5 font-mono text-[11px]">
            <span class="k text-[#1B2A4A]/70 uppercase tracking-[0.14em] text-[9.5px]">{L.date}</span>
            <span class="v ml-auto text-right text-[#1B2A4A] tabular-nums">{formattedDate}</span>
          </div>
          {formattedUpdated && (
            <div class="row hidden md:flex items-baseline gap-3 py-1.5 font-mono text-[11px]">
              <span class="k text-[#1B2A4A]/70 uppercase tracking-[0.14em] text-[9.5px]">
                {L.lastMod}
              </span>
              <span class="v ml-auto text-right text-[#1B2A4A] tabular-nums">{formattedUpdated}</span>
            </div>
          )}
          <div class="row hidden md:flex items-baseline gap-3 py-1.5 font-mono text-[11px]">
            <span class="k text-[#1B2A4A]/70 uppercase tracking-[0.14em] text-[9.5px]">
              {L.readTime}
            </span>
            <span class="v ml-auto text-right text-[#1B2A4A] tabular-nums">{readingTime}</span>
          </div>

          {fichaRows.map((r) => (
            <div class="row flex items-baseline gap-3 py-1.5 font-mono text-[11px]">
              <span class="k text-[#1B2A4A]/70 uppercase tracking-[0.14em] text-[9.5px]">{r.key}</span>
              <span class="v ml-auto text-right text-[#1B2A4A] tabular-nums">
                {r.href ? (
                  <a
                    href={r.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center min-h-[44px] md:min-h-0 py-1 no-underline border-b border-dotted border-[#C17654] text-[#1B2A4A] hover:text-[#A35E3E] hover:border-[#A35E3E]"
                  >
                    {r.value}
                  </a>
                ) : (
                  r.value
                )}
              </span>
            </div>
          ))}

          {tags.length > 0 && (
            <div class="block mt-6">
              <div
                class="lbl font-mono text-[10px] uppercase tracking-[0.18em] text-[#1B2A4A]/70 pb-2.5 border-b border-[#1B2A4A]/15 mb-3"
              >
                {L.topics}
              </div>
              <div class="tagset flex flex-wrap gap-1">
                {tags.map((tag) => (
                  <span class="font-mono text-[9px] uppercase tracking-[0.1em] border border-[#1B2A4A]/15 px-1.5 py-0.5 text-[#1B2A4A]/75">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          )}

          {relatedPosts.length > 0 && (
            <div class="block mt-6 md:sticky md:top-8 md:max-h-[calc(100vh-4rem)] md:overflow-y-auto">
              <div
                class="lbl font-mono text-[10px] uppercase tracking-[0.18em] text-[#1B2A4A]/70 pb-2.5 border-b border-[#1B2A4A]/15 mb-3"
              >
                {L.related}
              </div>
              <ul class="space-y-3 list-none p-0 m-0">
                {relatedPosts.map((r) => (
                  <li class="m-0">
                    <a
                      href={lang === 'es' ? `/blog/${r.slug}/` : `/en/blog/${r.slug}/`}
                      class="group/rel flex items-center min-h-[44px] md:min-h-0 py-1 no-underline"
                    >
                      <span class="flex items-baseline gap-1.5">
                        <span class="font-serif text-[13.5px] leading-snug text-[#1B2A4A] group-hover/rel:text-[#A35E3E] border-b border-dotted border-[#C17654]/60 group-hover/rel:border-[#A35E3E] pb-0.5 transition-colors">
                          {r.title}
                        </span>
                        <span
                          aria-hidden="true"
                          class="text-[11px] text-[#C17654] group-hover/rel:translate-x-0.5 transition-transform shrink-0"
                        >
                          {'\u2192'}
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      </div>

      <div class="mt-16 pt-6 border-t border-[#1B2A4A]/10">
        <a
          href={backHref}
          class="inline-flex items-center min-h-[44px] font-mono text-[11px] uppercase tracking-[0.12em] text-[#1B2A4A]/70 hover:text-[#A35E3E] no-underline"
        >
          &larr; {L.backToBlog}
        </a>
      </div>
    </div>
  </article>

  <script>
    import { track } from '../lib/analytics';

    function enhance() {
      const h1 = document.querySelector('article h1')?.textContent?.trim() ?? '';
      track('content_engaged', { page: h1 });

      const narrative = document.querySelector('.prose[data-shape="narrative"]');
      if (narrative) {
        const h2s = narrative.querySelectorAll(':scope > h2, :scope h2');
        h2s.forEach((h2, i) => {
          if (!h2.hasAttribute('data-n')) {
            h2.setAttribute('data-n', String(i + 1).padStart(2, '0'));
          }
        });
      }
    }

    enhance();
    document.addEventListener('astro:page-load', enhance);
  </script>
</BaseLayout>

<style is:global>
  /* Prose typography (cross-cutting defaults) --------------------------- */
  .prose h1 { font-family: 'Lora', Georgia, serif; }
  .prose h2 {
    font-family: 'Lora', Georgia, serif;
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.22;
    margin-top: 2.25rem;
    margin-bottom: 0.9rem;
    text-wrap: balance;
    letter-spacing: -0.01em;
  }
  .prose h3 {
    font-family: 'Lora', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 600;
    font-style: italic;
    color: #1B2A4A;
    margin-top: 1.6rem;
    margin-bottom: 0.5rem;
  }
  .prose h2:first-child { margin-top: 0; }
  .prose p {
    font-family: 'Lora', Georgia, serif;
    font-size: 1.02rem;
    max-width: 68ch;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
  }
  .prose ul, .prose ol { font-family: 'Lora', Georgia, serif; max-width: 68ch; }

  /* blog + case-study: terracotta H2, drop-cap on first paragraph ------- */
  .prose[data-shape="blog"] h2,
  .prose[data-shape="case-study"] h2 { color: #A35E3E; }

  .prose[data-shape="blog"] > p:first-of-type::first-letter,
  .prose[data-shape="case-study"] > p:first-of-type::first-letter {
    font-family: 'Lora', Georgia, serif;
    font-weight: 600;
    font-size: 3.4rem;
    line-height: 0.85;
    float: left;
    padding: 6px 10px 0 0;
    color: #C17654;
  }

  /* narrative: terracotta H2 with numbered ::before if data-n set ------- */
  .prose[data-shape="narrative"] h2 {
    color: #A35E3E;
    position: relative;
  }
  .prose[data-shape="narrative"] h2[data-n] {
    padding-left: 48px;
  }
  .prose[data-shape="narrative"] h2[data-n]::before {
    content: attr(data-n);
    position: absolute;
    left: 0;
    top: 0.5rem;
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: #a39c8e;
    border: 1px solid #CFC5B6;
    padding: 3px 7px;
    font-weight: 500;
  }

  /* study-guide: ink H2 with thin underline ---------------------------- */
  .prose[data-shape="study-guide"] h2 {
    color: #1B2A4A;
    border-bottom: 1px solid #CFC5B6;
    padding-bottom: 0.45rem;
    font-size: 1.35rem;
  }

  /* Inline authoring primitives (used across shapes via markdown HTML) - */
  .prose .pull {
    margin: 1.5rem 0;
    padding: 0.85rem 0 0.85rem 1.25rem;
    border-left: 3px solid #C17654;
    font-family: 'Lora', Georgia, serif;
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.45;
    color: #1B2A4A;
    max-width: 56ch;
  }

  .prose .callout {
    background: #1B2A4A;
    color: #EDE6DD;
    padding: 1rem 1.25rem;
    border-left: 3px solid #C17654;
    margin: 1.5rem 0;
    font-family: 'Inter', -apple-system, sans-serif;
    font-size: 0.95rem;
    border-radius: 2px;
  }
  .prose .callout code {
    background: #C17654 !important;
    color: #EDE6DD !important;
    border: none;
    padding: 2px 6px;
    font-weight: 600;
  }
  .prose .callout a { color: #D4A574; }

  .prose .keyidea {
    background: #E8E0D7;
    border: 1px solid #CFC5B6;
    padding: 0.9rem 1.15rem;
    margin: 1.25rem 0;
    font-family: 'Lora', Georgia, serif;
    font-size: 1rem;
    line-height: 1.55;
  }
  .prose .keyidea .lbl {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #C17654;
    margin-bottom: 0.35rem;
    font-style: normal;
  }

  /* Responsive overflow guards for markdown-authored content ----------- */
  .prose :where(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .prose :where(img, video, iframe, svg) { max-width: 100%; }
  .prose code { overflow-wrap: anywhere; }

  /* KaTeX readability (keep display math tidy) ------------------------- */
  .prose .katex-display { overflow-x: auto; overflow-y: hidden; padding: 0.25rem 0; }
  .prose .katex { font-size: 1.02em; }

  @media (max-width: 639px) {
    .prose h2 { font-size: 1.4rem; }
    .prose p {
      font-size: 1rem;
      text-align: left;
      hyphens: none;
    }
    .prose[data-shape="blog"] > p:first-of-type::first-letter,
    .prose[data-shape="case-study"] > p:first-of-type::first-letter {
      font-size: 3rem;
    }
  }
</style>
