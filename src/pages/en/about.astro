---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrganicBlob from '../../components/decorations/OrganicBlob.astro';
import Squiggle from '../../components/decorations/Squiggle.astro';

const lang = 'en';
const title = 'About · Andrés González Ortega';
const description = 'I am an actuary from UNAM and a performance marketing data specialist at Levely in Mexico City. I work on measurement and conversion analysis for growth (business growth guided by data) and go-to-market (GTM) decisions, and I build projects in insurance, data and artificial intelligence.';

const email = 'gonorandres@ciencias.unam.mx';
const github = 'https://github.com/GonorAndres';
const linkedin = 'https://www.linkedin.com/in/andr%C3%A9s-g%C3%B3nzalez-ortega-190b49371/';

// One first-person answer per question, shown on the page and reused as the
// FAQPage JSON-LD answer. `q` keeps the full name for search engines;
// `qVisible` is the heading shown on the page.
const faqs = [
  {
    q: 'Who is Andrés González Ortega?',
    qVisible: 'Who am I?',
    visible:
      'I am Andrés González Ortega. I trained in actuarial science at UNAM and am completing the requirements for my degree. Today I work as a performance marketing data specialist at Levely in Mexico City. My actuarial background shapes how I approach that work: what we can measure, what we need to estimate and what information we have to make a decision. By bringing together sales, advertising and digital behavior data, I try to understand the path to a purchase, even when the information is incomplete.',
  },
  {
    q: 'What does he do?',
    qVisible: 'What do I do?',
    visible:
      'At Levely, I build tools that help the team query data and follow their work. That work led to three articles in September 2026, using fictional examples: how to reconcile what an advertising platform reports with what the business records, check the journey from click to CRM before optimizing, and show on a dashboard up to what time the data is complete. That month, I also made a video about the actuarial equivalence principle with a coding agent and synthetic voice, in about two and a half hours. I built an insurance pricing lab and an app for booking coworking rooms on Cloudflare. In July, I set up gonor.me with email on my own domain. Earlier, I developed SIMA, a life insurance engine covering mortality, reserves and regulatory capital, and an AI assistant that searches the LISF and CUSF and cites the actual text. On the blog, I write about how I built each project, the problems that came up and what I had to adjust.',
  },
  {
    q: 'Where has he worked?',
    qVisible: 'Where have I worked?',
    visible:
      'I joined Levely in June 2026 as a performance marketing analyst. I work in growth, or business growth guided by data: I measure the conversion funnel and analyze purchase journeys. That analysis informs go-to-market (GTM) decisions, meaning how to bring a product or service to its audience, through which channels and with which messages. For measurement, I use Google Cloud, Google Analytics 4 and Google Tag Manager. Previously, I was a data scientist at Grupo Gigante from September 2025 to May 2026. There, I developed reports, models and data applications, worked on a data warehouse on Google Cloud with Cloud SQL, Cloud Run and BigQuery, and drove the design of a customer data platform (CDP) for one business unit.',
  },
  {
    q: 'What technologies and domains does he work in?',
    qVisible: 'What technologies do I use?',
    visible:
      'I work with Python, R and SQL to analyze data and build probability and risk models. I have built data platforms on Google Cloud and applications on Cloudflare, and trained a transformer from scratch. At Levely, I also help colleagues incorporate large language models (LLMs) into workflows they define themselves.',
  },
  {
    q: 'Where did he study?',
    qVisible: 'Where did I study?',
    visible:
      'I studied Actuarial Science at the Facultad de Ciencias of the Universidad Nacional Autónoma de México (UNAM) and am completing the requirements for my degree. During my social service at the UNAM Institute of Geophysics, I coauthored a scientific article on predicting eruptions of Popocatépetl.',
  },
  {
    q: 'What certifications does he hold?',
    qVisible: 'What certifications do I hold?',
    visible:
      'I passed Exam P of the Society of Actuaries (SOA) in March 2026. I hold the Databricks Fundamentals, AI Agent Fundamentals and Generative AI Fundamentals accreditations from Databricks Academy, the Google Cloud skill badge “Create ML Models with BigQuery ML” and DataCamp certifications in data analysis and data science.',
  },
  {
    q: 'How to reach him?',
    qVisible: 'How can you reach me?',
    visible: `You can email me at ${email}. I share my work and projects on GitHub and LinkedIn.`,
    contact: true,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.visible,
    },
  })),
};
---

<BaseLayout title={title} description={description} lang={lang} schemaType="profile">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <section class="relative overflow-hidden py-12 md:py-20 px-4 sm:px-6">
    <OrganicBlob variant={1} color="#D4A574" class="w-[480px] h-[480px] -top-24 -right-32 opacity-40" />
    <OrganicBlob variant={3} color="#7A8B6F" class="w-[340px] h-[340px] bottom-10 -left-24 opacity-30" />

    <div class="max-w-3xl mx-auto relative z-10">
      <header class="mb-12">
        <p class="text-sage font-medium text-lg mb-2">About</p>
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-navy leading-tight mb-4">
          Andrés González Ortega
        </h1>
        <p class="text-xl text-terracotta font-serif">
          Actuary · Performance marketing data specialist
        </p>
      </header>

      <Squiggle color="#C17654" class="w-full h-6 mb-12" />

      <div class="space-y-12">
        {faqs.map((f, i) => (
          <article class:list={['fade-up', i > 0 && 'pt-12 border-t border-navy/10']}>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-navy mb-4">
              {f.qVisible ?? f.q}
            </h2>
            <p class="text-navy/80 text-lg leading-relaxed">
              {f.visible}
            </p>
            {f.contact && (
              <div class="flex flex-wrap gap-3 mt-6">
                <a
                  href={`mailto:${email}`}
                  class="inline-block px-5 py-2.5 bg-terracotta text-cream font-medium rounded-xl hover:bg-terracotta/90 transition-colors"
                >
                  Email
                </a>
                <a
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block px-5 py-2.5 border-2 border-navy/20 text-navy font-medium rounded-xl hover:border-terracotta hover:text-terracotta transition-colors"
                >
                  GitHub
                </a>
                <a
                  href={linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block px-5 py-2.5 border-2 border-navy/20 text-navy font-medium rounded-xl hover:border-terracotta hover:text-terracotta transition-colors"
                >
                  LinkedIn
                </a>
                <a
                  href="/en/#proyectos"
                  class="inline-block px-5 py-2.5 border-2 border-navy/20 text-navy font-medium rounded-xl hover:border-terracotta hover:text-terracotta transition-colors"
                >
                  Projects
                </a>
                <a
                  href="/en/blog/"
                  class="inline-block px-5 py-2.5 border-2 border-navy/20 text-navy font-medium rounded-xl hover:border-terracotta hover:text-terracotta transition-colors"
                >
                  Blog
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
