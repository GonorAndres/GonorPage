---
import BaseLayout from '../../layouts/BaseLayout.astro';
import OrganicBlob from '../../components/decorations/OrganicBlob.astro';
import Squiggle from '../../components/decorations/Squiggle.astro';

const lang = 'en';
const title = 'About · Andrés González Ortega';
const description = 'Andrés González Ortega is an actuary from UNAM and a performance marketing data specialist at Levely in Mexico City. He works on measurement and conversion analysis for growth (business growth guided by data) and go-to-market (GTM) decisions, and builds projects in insurance, data and artificial intelligence.';

const email = 'gonorandres@ciencias.unam.mx';
const github = 'https://github.com/GonorAndres';
const linkedin = 'https://www.linkedin.com/in/andr%C3%A9s-g%C3%B3nzalez-ortega-190b49371/';

// Single source of truth per question: `a` is the third-person answer used in
// the FAQPage JSON-LD (search engines prefer full-name, self-contained
// answers); `visible` is the first-person text shown on the page. If
// `visible` is missing, `a` is shown.
const faqs = [
  {
    q: 'Who is Andrés González Ortega?',
    qVisible: 'Who am I?',
    a: 'Andrés González Ortega works in data analysis and application development, with a background in actuarial science. His projects span insurance, data engineering, artificial intelligence and quantitative finance.',
    visible:
      'I am Andrés González Ortega. I work in data analysis and application development, with a background in actuarial science. My projects span insurance, data engineering, artificial intelligence and quantitative finance.',
  },
  {
    q: 'What does he do?',
    qVisible: 'What do I do?',
    a: 'Andrés González Ortega developed SIMA, a life insurance engine covering mortality projection, reserves and regulatory capital, and an AI agent that searches Mexican regulation and cites the text of the LISF and CUSF. He has built data platforms on Google Cloud with BigQuery and trained a transformer from scratch. His projects are available online. On his blog, he documents their development, the difficulties he encountered and the adjustments he made.',
    visible:
      'I developed SIMA, a life insurance engine covering mortality projection, reserves and regulatory capital, and an AI agent that searches Mexican regulation and cites the text of the LISF and CUSF. I have built data platforms on Google Cloud with BigQuery and trained a transformer from scratch. The projects are available online. On the blog, I document their development, the difficulties I encountered and the adjustments I made.',
  },
  {
    q: 'Where has he worked?',
    qVisible: 'Where have I worked?',
    a: 'Andrés González Ortega has worked at Levely as a performance marketing analyst since June 2026. He combines sales, advertising and digital behavior data to analyze accounts and make recommendations. His work in growth, or business growth guided by data, covers measurement and analysis of the conversion funnel and purchase journeys. That analysis informs go-to-market (GTM) decisions: how to bring a product or service to its audience by choosing channels, audiences and messages. He builds tools for the team to query data and monitor accounts, and works on measurement quality with Google Cloud, Google Analytics 4 and Google Tag Manager. He helps colleagues incorporate large language models (LLMs) into workflows they define based on their subject knowledge and the needs of each task. He was a data scientist at Grupo Gigante from September 2025 to May 2026. There, he developed reports, models and data applications, and worked on centralizing information in a data warehouse on Google Cloud with Cloud SQL, Cloud Run and BigQuery. He drove the design of a customer data platform (CDP) to unify data sources for one business unit.',
    visible:
      'Since June 2026, I have worked at Levely as a performance marketing analyst. I combine sales, advertising and digital behavior data to analyze accounts and make recommendations. My work in growth, or business growth guided by data, covers measurement and analysis of the conversion funnel and purchase journeys. That analysis informs go-to-market (GTM) decisions: how to bring a product or service to its audience by choosing channels, audiences and messages. I build tools for the team to query data and monitor accounts, and work on measurement quality with Google Cloud, Google Analytics 4 and Google Tag Manager. I help colleagues incorporate large language models (LLMs) into workflows they define based on their subject knowledge and the needs of each task. Previously, I was a data scientist at Grupo Gigante from September 2025 to May 2026. There, I developed reports, models and data applications, and worked on centralizing information in a data warehouse on Google Cloud with Cloud SQL, Cloud Run and BigQuery. I drove the design of a customer data platform (CDP) to unify data sources for one business unit.',
  },
  {
    q: 'What technologies and domains does he work in?',
    qVisible: 'What technologies do I use?',
    a: 'Andrés González Ortega uses Python, R and SQL to work with data and probability and risk models. He deploys web applications using Google Cloud serverless services and integrates language models through retrieval-augmented generation (RAG) and agents. His site and several of his applications are available under his own domain.',
    visible:
      'I use Python, R and SQL to work with data and probability and risk models. I deploy web applications using Google Cloud serverless services and integrate language models through retrieval-augmented generation (RAG) and agents. This site and several of my applications are available under my own domain.',
  },
  {
    q: 'Where did he study?',
    qVisible: 'Where did I study?',
    a: 'Andrés González Ortega studied Actuarial Science at the Facultad de Ciencias of the Universidad Nacional Autónoma de México (UNAM) and is completing the requirements for his degree. His academic background includes probability, statistics, finance and risk theory.',
    visible:
      'I studied Actuarial Science at the Facultad de Ciencias of the Universidad Nacional Autónoma de México (UNAM) and am completing the requirements for my degree. My academic background includes probability, statistics, finance and risk theory.',
  },
  {
    q: 'What certifications does he hold?',
    qVisible: 'What certifications do I hold?',
    a: 'Andrés González Ortega passed Exam P of the Society of Actuaries (SOA). He holds the Databricks Fundamentals, AI Agent Fundamentals and Generative AI Fundamentals accreditations from Databricks Academy, the Google Cloud skill badge “Create ML Models with BigQuery ML” and DataCamp certifications in data analysis and data science.',
    visible:
      'I passed Exam P of the Society of Actuaries (SOA). I hold the Databricks Fundamentals, AI Agent Fundamentals and Generative AI Fundamentals accreditations from Databricks Academy, the Google Cloud skill badge “Create ML Models with BigQuery ML” and DataCamp certifications in data analysis and data science.',
  },
  {
    q: 'How to reach him?',
    qVisible: 'How can you reach me?',
    a: `Andrés González Ortega can be contacted by email at ${email}. He shares his work and projects on GitHub (${github}) and LinkedIn (${linkedin}).`,
    visible: `You can email me at ${email}. I share my work and projects on GitHub and LinkedIn.`,
    contact: true,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'en',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a,
    },
  })),
};
---

<BaseLayout title={title} description={description} lang={lang} schemaType="profile">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <section class="relative overflow-hidden py-12 md:py-20 px-4 sm:px-6">
    <OrganicBlob variant={1} color="#D4A574" class="w-[480px] h-[480px] -top-24 -right-32 opacity-40" />
    <OrganicBlob variant={3} color="#7A8B6F" class="w-[340px] h-[340px] bottom-10 -left-24 opacity-30" />

    <div class="max-w-3xl mx-auto relative z-10">
      <header class="mb-12">
        <p class="text-sage font-medium text-lg mb-2">About</p>
        <h1 class="font-serif text-4xl md:text-5xl font-bold text-navy leading-tight mb-4">
          Andrés González Ortega
        </h1>
        <p class="text-xl text-terracotta font-serif">
          Actuary · Performance marketing data specialist
        </p>
      </header>

      <Squiggle color="#C17654" class="w-full h-6 mb-12" />

      <div class="space-y-12">
        {faqs.map((f, i) => (
          <article class:list={['fade-up', i > 0 && 'pt-12 border-t border-navy/10']}>
            <h2 class="font-serif text-2xl md:text-3xl font-bold text-navy mb-4">
              {f.qVisible ?? f.q}
            </h2>
            <p class="text-navy/80 text-lg leading-relaxed">
              {f.visible ?? f.a}
            </p>
            {f.contact && (
              <div class="flex flex-wrap gap-3 mt-6">
                <a
                  href={`mailto:${email}`}
                  class="inline-block px-5 py-2.5 bg-terracotta text-cream font-medium rounded-xl hover:bg-terracotta/90 transition-colors"
                >
                  Email
                </a>
                <a
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block px-5 py-2.5 border-2 border-navy/20 text-navy font-medium rounded-xl hover:border-terracotta hover:text-terracotta transition-colors"
                >
                  GitHub
                </a>
                <a
                  href={linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block px-5 py-2.5 border-2 border-navy/20 text-navy font-medium rounded-xl hover:border-terracotta hover:text-terracotta transition-colors"
                >
                  LinkedIn
                </a>
                <a
                  href="/en/#proyectos"
                  class="inline-block px-5 py-2.5 border-2 border-navy/20 text-navy font-medium rounded-xl hover:border-terracotta hover:text-terracotta transition-colors"
                >
                  Projects
                </a>
                <a
                  href="/en/blog/"
                  class="inline-block px-5 py-2.5 border-2 border-navy/20 text-navy font-medium rounded-xl hover:border-terracotta hover:text-terracotta transition-colors"
                >
                  Blog
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
