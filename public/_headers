# Cloudflare Pages header rules.
#
# Both environments are Cloudflare Pages projects built from this repo:
# production `gonorpage` (served at gonor.me) and development `gonorpage-dev`.
# One file serves both, so the noindex rules below are scoped by HOST, never by
# path: they match only the auto-generated *.pages.dev hostnames (including
# <hash>.<project>.pages.dev previews), and never gonor.me.
#
# NEVER add an X-Robots-Tag under a path-only rule such as `/*`. It would apply
# to gonor.me and deindex the whole site. deploy.yml fails the build if any
# X-Robots-Tag appears under a rule that does not start with https://.
# See docs/DEPLOYMENT.md.

https://:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex, nofollow

# Astro emits content-hashed filenames under /_astro/, so they never change in
# place and can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
